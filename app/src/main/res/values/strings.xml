    <string name="notes_source_api">API di Google Keep</string>
    <string name="notes_source_api_hint">Solo per account Google Workspace con l\'API Keep abilitata dall\'amministratore. Sincronizzazione automatica.</string>
    <string name="notes_takeout_folder">Cartella degli export Takeout</string>
    <string name="notes_takeout_folder_hint">Scarica da takeout.google.com l\'export di \"Keep\" e salva lo zip (o la cartella estratta) qui: a ogni sincronizzazione viene usato l\'export più recente.</string>

    <!-- Sync options -->
    <string name="sync_on_change">Sincronizza alla modifica</string>
    <string name="sync_on_change_hint">Calendari e contatti vengono esportati pochi secondi dopo ogni modifica sul telefono (senza servizi in background).</string>
    <string name="sync_periodic">Sincronizzazione periodica</string>
    <string name="sync_periodic_hint">Unica opzione per Tasks e Keep, che non notificano le modifiche. Android consente al massimo una esecuzione ogni 15 minuti.</string>
